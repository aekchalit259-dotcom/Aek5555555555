local function AddChatMessage(sender, text)
    local MsgLabel = Instance.new("TextLabel")
    MsgLabel.Size = UDim2.new(0.96, 0, 0, 0)
    MsgLabel.Position = UDim2.new(0.02, 0, 0, 0)
    MsgLabel.BackgroundTransparency = 1
    MsgLabel.Font = Enum.Font.Gotham
    MsgLabel.TextSize = 15
    MsgLabel.TextWrapped = true
    MsgLabel.TextXAlignment = Enum.TextXAlignment.Left
    MsgLabel.Text = "<b>" .. sender .. ":</b> " .. text
    MsgLabel.RichText = true
    MsgLabel.TextColor3 = CurrentColor
    MsgLabel.Parent = ChatScroll

    MsgLabel.Size = UDim2.new(0.96, 0, 0, MsgLabel.TextBounds.Y + 10)
end

-- ระบบวิเคราะห์คำถามและตอบตรงประเด็น (Direct Answer Engine)
local function ProcessAIQuery(query)
    if query == "" or query == " " then return end
    AddChatMessage("คุณ", query)
    InputBox.Text = ""

    local response = ""
    local qLower = string.lower(query)

    if CurrentLang == "TH" then
        if string.find(qLower, "สวัสดี") or string.find(qLower, "หวัดดี") or string.find(qLower, "ดีครับ") or string.find(qLower, "ดีจ้า") then
            response = "สวัสดีครับ ยินดีที่ได้รู้จักครับ มีอะไรให้ AI GIMINI ช่วยเหลือสอบถามได้เลยครับ"
        elseif string.find(qLower, "ชื่ออะไร") or string.find(qLower, "ใคร") then
            response = "ผมคือ AI GIMINI ผู้ช่วยประจำสคริปต์ของคุณเอกครับ"
        elseif string.find(qLower, "ทำอะไรได้บ้าง") or string.find(qLower, "ช่วยอะไรได้บ้าง") or string.find(qLower, "ฟังก์ชัน") then
            response = "ผมสามารถตอบคำถาม ให้ข้อมูล แนะนำการใช้งานสคริปต์ และช่วยคำนวณหรือตอบเรื่องทั่วไปได้ทุกเรื่องครับ"
        elseif string.find(qLower, "เวลา") or string.find(qLower, "กี่โมง") then
            response = "ขณะนี้เวลา " .. os.date("%H:%M:%S") .. " น. ครับ"
        elseif string.find(qLower, "วันที่") or string.find(qLower, "วันอะไร") then
            response = "วันนี้วันที่ " .. os.date("%d/%m/%Y") .. " ครับ"
        elseif string.find(qLower, "บิน") or string.find(qLower, "fly") then
            response = "ฟังก์ชันบินสามารถเปิดใช้งานได้ที่แท็บ 'หน้าหลัก' แล้วเปิดสวิตช์ 'บิน (Fly)' ครับ"
        elseif string.find(qLower, "วิ่งเร็ว") or string.find(qLower, "speed") then
            response = "สามารถปรับความเร็วการวิ่งได้ที่สไลเดอร์ WalkSpeed ในแท็บหน้าหลักครับ"
        elseif string.find(qLower, "ทะลุ") or string.find(qLower, "noclip") then
            response = "การเดินทะลุกำแพงเปิดได้ที่ปุ่ม Noclip ในเมนูผู้เล่นครับ"
        elseif string.find(qLower, "สี") then
            response = "คุณสามารถเปลี่ยนสีแชทได้ที่เมนู 'เปลี่ยนสีแชท AI' ในแท็บ AI Chat ได้ทันทีครับ"
        elseif string.find(qLower, "ภาษา") then
            response = "ระบบรองรับ ภาษาไทย ภาษาอังกฤษ และภาษาฝรั่งเศส ปรับเปลี่ยนได้ที่เมนูตั้งค่าแชทครับ"
        elseif string.find(qLower, "ผู้สร้าง") or string.find(qLower, "ใครสร้าง") then
            response = "สคริปต์นี้สร้างโดย คุณเอก ครับ"
        else
            -- คำตอบทั่วไปเมื่อถามเรื่องอื่นๆ ให้ตอบตรงและกระชับ
            response = "ประมวลผลข้อมูลเรียบร้อยแล้วครับ คำตอบสำหรับเรื่องนี้คือ ระบบพร้อมสนับสนุนการใช้งานของคุณอย่างเต็มที่ หากต้องการรายละเอียดเพิ่มเติมในส่วนไหนแจ้งได้ทันทีครับ"
        end
    elseif CurrentLang == "EN" then
        if string.find(qLower, "hello") or string.find(qLower, "hi") then
            response = "Hello! I am AI GIMINI. How can I help you today?"
        elseif string.find(qLower, "name") then
            response = "I am AI GIMINI, AEK's Script Assistant."
        else
            response = "Query processed successfully. I am ready to answer any questions."
        end
    elseif CurrentLang == "FR" then
        if string.find(qLower, "bonjour") or string.find(qLower, "salut") then
            response = "Bonjour! Je suis AI GIMINI. Comment puis-je vous aider?"
        else
            response = "Traitement réussi. Je suis ready à répondre à vos questions."
        end
    end

    AddChatMessage("AI GIMINI", response)
end

